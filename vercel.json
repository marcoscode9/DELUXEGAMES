{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci",
  "fluid": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{index.html,server/schema.sql,data/**,public/**,*.webp,*.png,og-image.jpg,robots.txt,sitemap.xml}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
