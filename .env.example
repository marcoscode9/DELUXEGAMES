PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://deluxegames:YOUR_LOCAL_PASSWORD@localhost:55432/deluxegames
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
# Fill these to switch the app to Supabase. Blank keeps local Docker PostgreSQL.
# Copy the PostgreSQL URI from Connect > Direct connection (not the HTTPS project URL).
SUPABASE_DATABASE_URL=
# Quote the password with single quotes to preserve #, spaces and $ in Compose.
SUPABASE_DB_PASSWORD=
SUPABASE_DATABASE_SCHEMA=deluxegames
# Optional: server root certificate downloaded from Supabase Database settings.
# Save it in .local/certs/supabase-ca.crt. Same path works in Node and Docker.
SUPABASE_SSL_CA_FILE=
# Vercel: paste the downloaded root certificate PEM here instead of a local path.
SUPABASE_SSL_CA=
# Set only for local administrator bootstrap; do not commit passwords.
# ADMIN_EMAIL=admin@deluxegames.local
# ADMIN_PASSWORD=
